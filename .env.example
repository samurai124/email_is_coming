# ==========================================
# SENDER PROFILE & PERSONAL DETAILS
# ==========================================
SENDER_NAME="Your Full Name"
SENDER_EMAIL="your_email@gmail.com"
SENDER_PHONE="+1 (555) 123-4567"
SENDER_LINKEDIN="https://linkedin.com/in/yourprofile"
SENDER_PORTFOLIO="https://yourportfolio.com"

# Brief summary of your background/skills used by AI to pitch you
CANDIDATE_SUMMARY="Software Engineer with 3+ years of experience in Python, TypeScript, React, and cloud architectures. Passionate about high-performance backend systems and AI tooling."

# ==========================================
# EMAIL SMTP CONFIGURATION
# ==========================================
# For Gmail:
#   SMTP_SERVER=smtp.gmail.com
#   SMTP_PORT=587
#   SENDER_PASSWORD=16-character Google App Password (NOT your normal password)
#   (To create one: Google Account -> Security -> 2-Step Verification -> App passwords)
#
# For Outlook / Office 365:
#   SMTP_SERVER=smtp.office365.com
#   SMTP_PORT=587
#
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_PASSWORD="your-16-char-app-password"

# ==========================================
# AI PERSONALIZATION (Google Gemini API)
# ==========================================
# Get a free API key at: https://aistudio.google.com
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ==========================================
# FILES & DIRECTORIES
# ==========================================
# Place your resume inside the data/resumes folder
RESUME_FILENAME="resume.pdf"
CSV_FILENAME="companies.csv"

# ==========================================
# SAFETY & RATE LIMITING
# ==========================================
# Cooldown between emails in seconds (prevents triggering spam filters)
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=45

# Maximum emails to send in a single batch
DAILY_MAX_EMAILS=40
